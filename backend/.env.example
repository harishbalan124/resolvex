# ResolveX Environment Variables
PROJECT_NAME="ResolveX"
ENVIRONMENT="development"
DEBUG=True

# Security (Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY="replace_with_a_secure_random_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resolvex_db"

# Rate Limiting (SlowAPI)
DEFAULT_RATE_LIMIT="60/minute"
AUTH_RATE_LIMIT="10/minute"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
